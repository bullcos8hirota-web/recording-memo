@echo off
chcp 65001 >nul
cd /d "%~dp0"

rem =====================================================================
rem  スタジオ映像同期サーバー 起動用（Windows・ダブルクリックで起動）
rem  -------------------------------------------------------------------
rem  ・事前に Node.js (https://nodejs.org/ のLTS版) をインストールして
rem    ください。1回だけでOKです。
rem  ・このファイルと sync-server.js を同じフォルダに置いてください。
rem  ・下の DURATION に動画の長さ（秒）を入れてください。例: 604
rem =====================================================================

set DURATION=1800

node sync-server.js

echo.
echo サーバーが停止しました。ウィンドウを閉じてください。
pause >nul
